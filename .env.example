# Copy to .env (local) — never commit real secrets
NODE_ENV=development
# Local Docker Postgres (Phase 1 dev)
DATABASE_URL=postgresql://gym:gym@localhost:5432/gym?schema=public
DIRECT_URL=postgresql://gym:gym@localhost:5432/gym?schema=public
# Render + Neon (staging/prod) — set in Render dashboard, NOT here:
# DATABASE_URL=postgresql://...neon...?sslmode=require&pgbouncer=true
# DIRECT_URL=postgresql://...neon...?sslmode=require
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars-min
SESSION_SECRET=dev-session-secret-change-me-32ok
CSRF_SECRET=dev-csrf-secret-change-me-32-ok!
JOBS_SECRET=dev-jobs-secret-change-me-32-ok!!
DEVICE_API_KEYS=dev-device-key-1
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
GYM_TIMEZONE=Asia/Kolkata
GST_DEFAULT_PCT=18
PORT_API=4000
