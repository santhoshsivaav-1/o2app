generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  name           String
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  userRoles      UserRole[]
  sessions       Session[]
  trainedMembers Member[]  @relation("TrainerMembers")
  assignedEnquiries Enquiry[] @relation("EnquiryAssignee")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  refreshHash String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model GenderCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
}

model Member {
  id                String          @id @default(uuid())
  memberCode        String          @unique
  fullName          String
  mobile            String
  mobileNorm        String
  email             String?
  genderId          String
  gender            GenderCategory  @relation(fields: [genderId], references: [id], onDelete: Restrict)
  dob               DateTime?       @db.Date
  address           String?
  emergencyContact  String?
  registrationDate  DateTime        @default(now()) @db.Date
  photoUrl          String?
  notes             String?
  status            String          @default("active")
  source            String?
  assignedTrainerId String?
  assignedTrainer   User?           @relation("TrainerMembers", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  deviceUserId      String?         @unique
  archivedAt        DateTime?
  archivedById      String?
  createdById       String?
  updatedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  memberNotes       MemberNote[]
  memberships       Membership[]
  invoices          Invoice[]
  payments          Payment[]
  credits           CreditAdjustment[]
  convertedFrom     Enquiry[]   @relation("EnquiryConversion")
  deviceMappings    DeviceUserMapping[]
  attendanceEvents  AttendanceEvent[]
  attendanceRecords AttendanceRecord[]

  @@index([mobileNorm])
  @@index([status])
  @@index([fullName])
  @@index([registrationDate])
}

model MemberNote {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  body        String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([memberId])
}

model Package {
  id              String   @id @default(uuid())
  name            String
  description     String?
  durationValue   Int
  durationUnit    String   @default("MONTH")
  durationDays    Int
  price           Decimal  @db.Decimal(12, 2)
  registrationFee Decimal  @default(0) @db.Decimal(12, 2)
  discountMaxPct  Decimal? @db.Decimal(5, 2)
  gstPercent      Decimal? @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  eligibility     String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships Membership[]
  enquiries   Enquiry[]

  @@index([isActive])
}

model SeqCounter {
  name String
  year Int
  last Int @default(0)

  @@id([name, year])
}

model Membership {
  id              String    @id @default(uuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  packageId       String
  package         Package   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  status          String    @default("active")
  price           Decimal   @db.Decimal(12, 2)
  registrationFee Decimal   @default(0) @db.Decimal(12, 2)
  discountPct      Decimal   @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(12, 2)
  gstPercent      Decimal   @default(0) @db.Decimal(5, 2)
  gstAmount       Decimal   @default(0) @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  notes           String?
  renewedFromId   String?
  renewedFrom     Membership?  @relation("RenewalChain", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedBy       Membership[] @relation("RenewalChain")
  idempotencyKey  String?   @unique
  suspendedAt     DateTime?
  suspensionDays  Int       @default(0)
  cancelledAt     DateTime?
  cancelReason    String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoice         Invoice?
  renewals        RenewalEvent[] @relation("RenewedMembership")
  previousRenewals RenewalEvent[] @relation("PreviousMembership")
  statusHistory   MembershipStatusHistory[]

  @@index([memberId])
  @@index([packageId])
  @@index([status])
  @@index([endDate])
}

model RenewalEvent {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation("RenewedMembership", fields: [membershipId], references: [id], onDelete: Cascade)
  previousId   String
  previous     Membership @relation("PreviousMembership", fields: [previousId], references: [id], onDelete: Restrict)
  actorId      String?
  note         String?
  createdAt    DateTime   @default(now())

  @@index([membershipId])
}

model MembershipStatusHistory {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  from         String
  to           String
  actorId      String?
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([membershipId])
}

model Invoice {
  id           String        @id @default(uuid())
  invoiceNo    String        @unique
  memberId     String
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membershipId String        @unique
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  subtotal     Decimal       @db.Decimal(12, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  taxable      Decimal       @db.Decimal(12, 2)
  gst          Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  status       String        @default("unpaid")
  issuedAt     DateTime      @default(now())
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        InvoiceItem[]
  allocations  PaymentAllocation[]
  refunds      Refund[]

  @@index([memberId])
  @@index([status])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label     String
  qty       Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

model Payment {
  id             String              @id @default(uuid())
  memberId       String
  member         Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  method         String
  amount         Decimal             @db.Decimal(12, 2)
  paidAt         DateTime            @default(now())
  reference      String?
  verified       Boolean             @default(false)
  idempotencyKey String?             @unique
  receivedById   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  allocations    PaymentAllocation[]
  refunds        Refund[]
  credits        CreditAdjustment[]

  @@index([memberId])
  @@index([paidAt])
  @@index([method])
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model Refund {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

model CreditAdjustment {
  id              String   @id @default(uuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amount          Decimal  @db.Decimal(12, 2)
  remaining       Decimal  @db.Decimal(12, 2)
  sourcePaymentId String?
  sourcePayment   Payment? @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)
  note            String?
  createdById     String?
  createdAt       DateTime @default(now())

  @@index([memberId])
}

model Enquiry {
  id               String     @id @default(uuid())
  enquiryNo        String     @unique
  name             String
  phone            String
  phoneNorm        String
  email            String?
  interest         String?
  interestPackageId String?
  interestPackage  Package?   @relation(fields: [interestPackageId], references: [id], onDelete: SetNull)
  source           String?
  enquiryDate      DateTime   @default(now()) @db.Date
  assignedToId     String?
  assignedTo       User?      @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status           String     @default("new")
  nextFollowUpAt   DateTime?
  notes            String?
  convertedMemberId String?
  convertedMember  Member?    @relation("EnquiryConversion", fields: [convertedMemberId], references: [id], onDelete: SetNull)
  convertedAt      DateTime?
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  followUps        FollowUp[]

  @@index([status])
  @@index([phoneNorm])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
  @@index([enquiryDate])
}

model FollowUp {
  id          String    @id @default(uuid())
  enquiryId   String
  enquiry     Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  activity    String
  note        String?
  dueAt       DateTime?
  doneAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([enquiryId])
  @@index([dueAt])
}

model AttendanceDevice {
  id                String              @id @default(uuid())
  deviceCode        String              @unique
  name              String
  model             String?
  apiKeyHash        String?
  isActive          Boolean             @default(true)
  duplicateWindowMin Int                @default(5)
  lastSeenAt        DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  mappings          DeviceUserMapping[]
  events            AttendanceEvent[]
  syncRuns          DeviceSyncRun[]
}

model DeviceUserMapping {
  id           String           @id @default(uuid())
  deviceId     String
  device       AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceUserId String
  memberId     String?
  member       Member?          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  status       String           @default("active")
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([deviceId, deviceUserId])
  @@index([memberId])
}

model AttendanceEvent {
  id           String           @id @default(uuid())
  deviceId     String?
  device       AttendanceDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  dedupeKey    String           @unique
  deviceUserId String
  deviceEventId String?
  occurredAt   DateTime
  receivedAt   DateTime         @default(now())
  source       String           @default("device")
  status       String           @default("mapped")
  memberId     String?
  member       Member?          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  recordId     String?
  record       AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([occurredAt])
  @@index([deviceUserId])
  @@index([memberId])
  @@index([status])
}

model AttendanceRecord {
  id          String                @id @default(uuid())
  memberId    String
  member      Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  date        DateTime              @db.Date
  checkInAt   DateTime
  source      String                @default("device")
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  events      AttendanceEvent[]
  corrections AttendanceCorrection[]

  @@unique([memberId, date])
  @@index([date])
  @@index([memberId])
}

model AttendanceCorrection {
  id        String           @id @default(uuid())
  recordId  String
  record    AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  before    String
  after     String
  actorId   String?
  reason    String
  createdAt DateTime         @default(now())

  @@index([recordId])
}

model DeviceSyncRun {
  id         String           @id @default(uuid())
  deviceId   String
  device     AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  fetched    Int              @default(0)
  ingested   Int              @default(0)
  duplicates Int              @default(0)
  unmapped   Int              @default(0)
  error      String?

  @@index([deviceId])
}
